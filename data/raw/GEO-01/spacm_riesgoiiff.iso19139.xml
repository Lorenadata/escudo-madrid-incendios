                     <gmd:description>
                        <gco:CharacterString>Valoración del riesgo por combinación de los valores de peligrosidad y vulnerabilidad para el riesgo considerado, en cada punto del territorio</gco:CharacterString>
                     </gmd:description>
                     <gmd:sourceExtent gco:nilReason="missing"/>
                  </gmd:LI_Source>
               </gmd:source>
